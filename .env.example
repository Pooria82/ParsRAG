# Application
PARSRAG_PORT=8000
PARSRAG_BIND_HOST=127.0.0.1
PARSRAG_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host names the API answers to. Empty means loopback only (localhost,
# 127.0.0.1, ::1). Add a LAN name or IP when PARSRAG_BIND_HOST exposes the app.
PARSRAG_ALLOWED_HOSTS=
ENVIRONMENT=production
LOG_LEVEL=INFO
PARSRAG_MAX_REQUEST_BYTES=534773760
# RAM-backed /tmp that holds uploads while a request is processed; keep it at
# least as large as PARSRAG_MAX_REQUEST_BYTES.
PARSRAG_TMPFS_SIZE=576m
PARSRAG_MAX_FILES_PER_SESSION=10
PARSRAG_MAX_FILE_BYTES=104857600
PARSRAG_MAX_BATCH_BYTES=524288000
PARSRAG_INGEST_CONCURRENCY=1
PARSRAG_QUERY_CONCURRENCY=2
PARSRAG_CPU_THREADS=4
PARSRAG_APP_MEMORY_LIMIT=6g
QDRANT_MEMORY_LIMIT=2g
OLLAMA_MEMORY_LIMIT=12g

# Qdrant (localhost for native development; Compose overrides this to qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional explicit collection name. Leave blank for embedding-versioned collections.
QDRANT_COLLECTION=

# Model provider: ollama or api/openrouter
LLM_PROVIDER=ollama
LLM_MODEL_NAME=gemma3:12b
OLLAMA_BASE_URL=http://localhost:11434
# Internal/remote Ollama URL used specifically by the application container.
OLLAMA_DOCKER_BASE_URL=http://ollama:11434
OLLAMA_INTERNAL_HOST=
OLLAMA_MODEL=gemma3:12b
OLLAMA_IMAGE=ollama/ollama:0.34.1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
# Context requested from Ollama (num_ctx). Retrieved chunks are trimmed to fit.
OLLAMA_CONTEXT_LENGTH=8192
# Used only by compose.gpu-low-vram.yaml.
OLLAMA_LOW_VRAM_CONTEXT_LENGTH=2048
OLLAMA_LOW_VRAM_FIT_TARGET=0

# Seconds per answer request (API requests are retried once) and for the
# follow-up rewrite; together they stay below the browser's 330 s limit.
LLM_REQUEST_TIMEOUT_SECONDS=120
CONDENSE_TIMEOUT_SECONDS=30

# OpenAI-compatible model API (public endpoints require HTTPS; private IPs may use HTTP)
# Context window assumed for API models when budgeting prompts.
MODEL_CONTEXT_WINDOW=32768
MODEL_API_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
# Set to 1 only after accepting that an external model service receives prompts
# and retrieved document excerpts when LLM_PROVIDER=api.
MODEL_API_DISCLOSURE_ACKNOWLEDGED=0

# Backward-compatible OpenRouter aliases
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Non-secret active model settings are persisted here; API keys are never written.
PARSRAG_CONFIG_PATH=data/model-configuration.json

# Embeddings
EMBED_MODEL_NAME=intfloat/multilingual-e5-base
# 1 = use E5 "query: "/"passage: " prefixes (new collection: re-upload documents)
EMBED_E5_PREFIXES=0
# auto selects CUDA only when the CUDA image/profile exposes a compatible GPU.
EMBED_DEVICE=auto
EMBED_BATCH_SIZE=8
QDRANT_UPSERT_BATCH_SIZE=64
HF_HUB_DISABLE_XET=1

# OCR for scanned PDF pages, standalone images, and images embedded in DOCX/PPTX
OCR_ENABLED=1
OCR_LANGUAGES=fas+eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=45
OCR_MAX_PAGES=30
OCR_MAX_IMAGES=30
OCR_MAX_IMAGE_PIXELS=40000000
OCR_MIN_IMAGE_PIXELS=10000

# Retrieval
STRICT_RAG_THRESHOLD=0.75
# Leave the depth overrides empty to use adaptive depth (8-30 chunks chosen
# per question). Set a number (1-50) to force a fixed depth for every query.
RAG_TOP_K=
STRICT_RAG_TOP_K=
HYBRID_RETRIEVE_TOP_K=25
HYBRID_RERANK_TOP_K=
# Hybrid cross-encoder (FlashRank model name, or "none" for vector order).
# It is downloaded once into the persistent model cache.
RERANK_MODEL=miniReranker_arabic_v1
RERANK_CACHE_DIR=
