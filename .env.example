# Qdrant configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL_NAME=google/gemma-4-26b-a4b-it:free
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model
EMBED_MODEL_NAME=intfloat/multilingual-e5-base

# App config
ENVIRONMENT=development
LOG_LEVEL=INFO
STRICT_RAG_THRESHOLD=0.80

# Retrieval & Multi-chunk Aggregation Depth
RAG_TOP_K=15
STRICT_RAG_TOP_K=15
HYBRID_RETRIEVE_TOP_K=25
HYBRID_RERANK_TOP_K=15