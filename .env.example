# ParsRAG settings. Copy this file to .env, then:
#
#   1. REQUIRED: choose the model in section 1. Nothing else is needed for
#      a working start.
#   2. OPTIONAL: every other line starts with "#" and shows the default.
#      Remove the "#" only to change a value.
#        - Section 2 can also be changed later in the app (Settings), without
#          a restart. A value saved in the app takes precedence over .env and
#          can be reset to it.
#        - Section 3 applies only from .env, after a restart.

###############################################################################
# 1. REQUIRED: the model
###############################################################################
# Pick ONE of the three options. The app's Settings can switch between them
# later without a restart.

# Option A (default): Ollama installed on this computer, using its models and
# GPU. Install Ollama, pull a model (`ollama pull qwen2.5:7b`), and start with
# `docker compose up -d --build`. On Linux, see the README for OLLAMA_HOST.
LLM_PROVIDER=ollama
LLM_MODEL_NAME=qwen2.5:7b
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434

# Option B: Ollama inside Docker (downloads the model into a volume once).
# Start with `--profile local-model` and set:
#   LLM_PROVIDER=ollama
#   LLM_MODEL_NAME=qwen2.5:7b
#   OLLAMA_MODEL=qwen2.5:7b
#   OLLAMA_DOCKER_BASE_URL=http://ollama:11434

# Option C: an OpenAI-compatible API (Google AI Studio, OpenRouter, or your
# own server). Public endpoints must use HTTPS. Set LLM_PROVIDER=api and:
#   LLM_MODEL_NAME=gemini-flash-lite-latest
#   MODEL_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   MODEL_API_KEY=your-key
# Set to 1 only after accepting that an external service receives your
# questions and the matching document excerpts:
#   MODEL_API_DISCLOSURE_ACKNOWLEDGED=1
# The API key can instead be entered in Settings; it is never written to disk.
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_API_DISCLOSURE_ACKNOWLEDGED=0

###############################################################################
# 2. OPTIONAL: also changeable in the app (Settings)
###############################################################################

# --- Settings > Model & connection > Advanced model settings ---
# Context Ollama allocates per question (num_ctx); lower it on small GPUs.
# OLLAMA_CONTEXT_LENGTH=8192
# Let thinking models (qwen3, qwen3.5, deepseek-r1) reason before answering;
# needs a larger context, or the answer can come back empty.
# OLLAMA_THINK=0
# Context assumed for API models; lower it for free tiers with token limits.
# MODEL_CONTEXT_WINDOW=32768
# Retries for temporary API errors (HTTP 5xx and 429).
# MODEL_API_MAX_RETRIES=4
# Seconds per answer, and for rewriting a follow-up question.
# LLM_REQUEST_TIMEOUT_SECONDS=120
# CONDENSE_TIMEOUT_SECONDS=30

# --- Settings > Answers > Server retrieval ---
# Evidence a documents-only answer needs (0-1; higher is stricter).
# STRICT_RAG_THRESHOLD=0.75
# Passages per question; empty = chosen per question (recommended), or 1-50.
# STRICT_RAG_TOP_K=
# HYBRID_RETRIEVE_TOP_K=25
# HYBRID_RERANK_TOP_K=
# Older name for STRICT_RAG_TOP_K, still read.
# RAG_TOP_K=
# Exact keyword (BM25) matches next to semantic search; 0 turns it off.
# KEYWORD_SEARCH=1

# --- Settings > Documents & speed ---
# PARSRAG_MAX_FILES_PER_SESSION=10
# PARSRAG_MAX_FILE_BYTES=104857600
# PARSRAG_MAX_BATCH_BYTES=524288000
# Read text in images, scanned PDFs, and pictures inside Word/PowerPoint.
# OCR_ENABLED=1
# OCR_LANGUAGES=fas+eng
# OCR_DPI=200
# Straighten sideways, upside-down, and skewed scans; 0 turns it off.
# OCR_ORIENTATION=1
# OCR_TIMEOUT_SECONDS=45
# OCR_MAX_PAGES=30
# OCR_MAX_IMAGES=200
# OCR_MIN_IMAGE_PIXELS=10000
# Keep a small copy of each image so answer sources can show it.
# SOURCE_IMAGE_PREVIEWS=1
# Images read at the same time; empty = half the CPU cores.
# OCR_WORKERS=
# Texts per embedding pass (8 on CPU, 32 with the GPU overlay).
# EMBED_BATCH_SIZE=8
# CPU threads for embeddings; up to the physical cores speeds up indexing.
# PARSRAG_CPU_THREADS=4
# QDRANT_UPSERT_BATCH_SIZE=64

###############################################################################
# 3. OPTIONAL: .env only (restart to apply)
###############################################################################

# --- Address and security ---
# PARSRAG_PORT=8000
# Network interface; keep 127.0.0.1 unless other devices must reach the app.
# PARSRAG_BIND_HOST=127.0.0.1
# Host names the API answers to besides localhost, 127.0.0.1, and ::1 (needed
# when PARSRAG_BIND_HOST exposes the app on a network).
# PARSRAG_ALLOWED_HOSTS=
# PARSRAG_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Extra hosts an Ollama URL may use besides localhost, ollama, and
# host.docker.internal (comma-separated; plain http only).
# OLLAMA_ALLOWED_HOSTS=

# --- Largest upload request ---
# The upload limits in section 2 cannot exceed this. Keep PARSRAG_TMPFS_SIZE
# (RAM that holds an upload while it is processed) at least as large.
# PARSRAG_MAX_REQUEST_BYTES=534773760
# PARSRAG_TMPFS_SIZE=576m

# --- Memory and concurrency ---
# PARSRAG_APP_MEMORY_LIMIT=6g
# QDRANT_MEMORY_LIMIT=2g
# OLLAMA_MEMORY_LIMIT=12g
# PARSRAG_INGEST_CONCURRENCY=1
# PARSRAG_QUERY_CONCURRENCY=2

# --- Embedding and reranking models (changing the embedding model needs the
# documents uploaded again) ---
# EMBED_MODEL_NAME=intfloat/multilingual-e5-base
# EMBED_E5_PREFIXES=0
# auto uses CUDA only with the GPU overlay and a compatible GPU.
# EMBED_DEVICE=auto
# FlashRank reranker for hybrid answers, or "none".
# RERANK_MODEL=miniReranker_arabic_v1
# RERANK_CACHE_DIR=
# HF_HUB_DISABLE_XET=1
# Images larger than this are skipped (protects against decompression bombs).
# OCR_MAX_IMAGE_PIXELS=40000000

# --- Ollama container (option B, --profile local-model) ---
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_IMAGE=ollama/ollama:0.34.1
# OLLAMA_KEEP_ALIVE=5m
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_FLASH_ATTENTION=1
# Used only by compose.gpu-low-vram.yaml.
# OLLAMA_LOW_VRAM_CONTEXT_LENGTH=2048
# OLLAMA_LOW_VRAM_FIT_TARGET=0
# Compose service name of the Ollama container (kept for compatibility).
# OLLAMA_INTERNAL_HOST=ollama

# --- Qdrant ---
# Leave empty to keep one collection per embedding model.
# QDRANT_COLLECTION=

# --- Logging ---
# ENVIRONMENT=production
# LOG_LEVEL=INFO

# --- Older names, still read ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=

# --- Running without Docker (native development) ---
# Compose sets these for the containers; a native run reads them from .env.
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# OLLAMA_BASE_URL=http://localhost:11434
# PARSRAG_CONFIG_PATH=data/model-configuration.json
# Docker turns OCR on; a native run needs it set explicitly.
# OCR_ENABLED=1
